# Create a .gitignore file in your repository's root directory
# to tell Git which files and directories to ignore when you make a commit.
#
# A collection of .gitignore templates
#  https://github.com/github/gitignore
#
# Build artifacts
build/
dist/
out/
target/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Python
__pycache__/
*.pyc
venv/

# Node.js
node_modules/
npm-debug.log*

# Environment files
.env
.env.*

# Archives
*.zip
*.tar
*.gz

# Temporary files
*.tmp
*.swp

# Security
secrets.*
credentials.*
